# Konfigurasi Environment Django - PCM Gatak
# Salin file ini menjadi .env untuk konfigurasi lokal

SECRET_KEY=ganti-dengan-secret-key-acak-yang-kuat-di-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# DATABASE_URL:
# Kosongkan untuk menggunakan SQLite (development lokal)
# Isi dengan connection string PostgreSQL untuk Docker / Production (Supabase/Neon)
# Contoh: postgresql://postgres:password@localhost:5432/pcm_gatak_db
DATABASE_URL=
